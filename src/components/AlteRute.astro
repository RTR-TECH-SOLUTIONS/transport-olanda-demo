---
// Linkuri spre celelalte țări și spre celălalt serviciu de pe aceeași rută.
import { caleRuta, tari, type Serviciu, type Tara } from '../data';
import { url } from '../lib/url';

interface Props {
  tara: Tara;
  serviciu: Serviciu;
}

const { tara, serviciu } = Astro.props;
const celalalt: Serviciu = serviciu === 'persoane' ? 'colete' : 'persoane';
const linkuri = [
  { href: url(caleRuta(celalalt, tara.slug)), text: `Transport ${celalalt} România – ${tara.nume}` },
  ...tari
    .filter((t) => t.slug !== tara.slug)
    .map((t) => ({ href: url(caleRuta(serviciu, t.slug)), text: `Transport ${serviciu} România – ${t.nume}` })),
];
---

<section class="container-site apare pb-14">
  <h2 class="text-[1.3rem] font-normal">Alte rute</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      linkuri.map((link) => (
        <li>
          <a href={link.href} class="ridicat flex items-center justify-between gap-4 rounded-(--radius-banda) px-5 py-3.5 text-far-50 transition-colors duration-200 hover:text-placuta-400">
            {link.text}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-placuta-500" aria-hidden="true">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</section>
