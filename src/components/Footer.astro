---
import { caleRuta, firma, tari, whatsappLink } from '../data';
import { url } from '../lib/url';
---

<footer class="subsol bg-asfalt-900">
  <div class="container-site grid gap-10 px-4 pt-10 pb-8 md:grid-cols-3">
    <div class="space-y-2.5">
      <h2 class="text-[1.08rem] font-semibold">{firma.nume}</h2>
      <p>Transport persoane și colete între România și {tari.map((t) => t.nume).join(', ')}.</p>
      <h2 class="pt-1 text-[1.08rem] font-normal">Telefon</h2>
      <p><a href={firma.telefonLink} class="hover:text-placuta-400">{firma.telefon}</a></p>
      <p><a href={whatsappLink()} target="_blank" rel="noopener" class="hover:text-placuta-400">Scrie-ne pe WhatsApp</a></p>
    </div>

    <div>
      <h2 class="text-[1.08rem] font-normal">Transport persoane</h2>
      <ul class="lista-buline mt-3 space-y-2">
        {
          tari.map((t) => (
            <li>
              <a href={url(caleRuta('persoane', t.slug))} class="hover:text-placuta-400">Transport persoane România – {t.nume}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-[1.08rem] font-normal">Transport colete</h2>
      <ul class="lista-buline mt-3 space-y-2">
        {
          tari.map((t) => (
            <li>
              <a href={url(caleRuta('colete', t.slug))} class="hover:text-placuta-400">Transport colete România – {t.nume}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-site flex flex-wrap justify-between gap-x-8 gap-y-2 border-t border-asfalt-700 px-4 py-7">
    <p>© {new Date().getFullYear()} {firma.nume}. Toate drepturile rezervate.</p>
    <p>
      Site realizat de <a href="https://rtrsolutions.ro" target="_blank" rel="noopener" class="text-far-50 hover:text-placuta-400">RTR Solutions</a>
    </p>
  </div>
</footer>

<style>
  .subsol {
    box-shadow: 0 -2px 10px rgb(0 0 0 / 0.45);
  }
</style>
