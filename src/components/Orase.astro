---
import { Image } from 'astro:assets';
import fotoRomania from '../assets/romania.jpg';
import { oraseRomania, type Serviciu, type Tara } from '../data';
import { fotoTara } from '../lib/foto';

interface Props {
  tara: Tara;
  serviciu: Serviciu;
}

const { tara, serviciu } = Astro.props;
const colete = serviciu === 'colete';

const coloane = [
  {
    titlu: tara.nume,
    eticheta: colete ? 'Unde predăm' : 'Unde te lăsăm',
    foto: fotoTara[tara.slug].src,
    alt: fotoTara[tara.slug].alt,
    text: `${tara.acoperire} Mai jos sunt câteva dintre orașele mari.`,
    orase: tara.orase,
    nota: 'Nu îți găsești localitatea în listă? Ajungem și acolo. Spune-ne adresa la telefon.',
  },
  {
    titlu: 'România',
    eticheta: colete ? 'De unde ridicăm' : 'De unde te luăm',
    foto: fotoRomania,
    alt: 'Transfăgărășanul văzut de sus, cu serpentinele spre Bâlea',
    text: colete
      ? 'Ridicăm colete de la adresă din toată țara, din orașe și din comune.'
      : 'Preluăm pasageri de la adresă din toată țara, din orașe și din comune.',
    orase: oraseRomania,
    nota: 'Lista are doar câteva exemple. Preluăm din orice județ.',
  },
];
---

<section id="orase" class="container-site apare">
  <h2 class="titlu-sectiune">Orașe deservite</h2>
  <hr class="linie" />
  <p>
    {
      colete
        ? `Ducem colete între România și ${tara.nume}, în ambele sensuri, de la adresă la adresă.`
        : `Facem transport de persoane între România și ${tara.nume}, în ambele sensuri, de la adresă la adresă.`
    }
  </p>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    {
      coloane.map((col) => (
        <article class="ridicat overflow-hidden rounded-(--radius-card)">
          <div class="relative">
            <Image
              src={col.foto}
              alt={col.alt}
              widths={[480, 800, 1300]}
              sizes="(min-width: 768px) 38rem, 94vw"
              class="aspect-[16/7] w-full object-cover"
            />
            <div class="voal absolute inset-0"></div>
            <div class="absolute inset-x-5 bottom-4 sm:inset-x-6">
              <p class="text-[0.9rem] text-far-300">{col.eticheta}</p>
              <h3 class="text-[1.75rem] leading-tight font-semibold text-white">{col.titlu}</h3>
            </div>
          </div>

          <div class="p-5 sm:p-6">
            <p>{col.text}</p>
            <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2.5 text-far-50 sm:grid-cols-3">
              {
                col.orase.map((oras) => (
                  <li class="oras">{oras}</li>
                ))
              }
            </ul>
            <p class="mt-5 border-t border-asfalt-700 pt-4 text-[0.95rem] text-far-500">{col.nota}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* voal doar în partea de jos a pozei, cât să se citească titlul */
  .voal {
    background: linear-gradient(to top, rgb(9 10 8 / 0.88) 0%, rgb(9 10 8 / 0.35) 45%, rgb(9 10 8 / 0) 75%);
  }

  .oras {
    position: relative;
    padding-left: 1.1rem;
  }

  .oras::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-placuta-500);
  }
</style>
