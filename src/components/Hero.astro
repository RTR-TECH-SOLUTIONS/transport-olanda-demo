---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { firma, garantii, whatsappLink } from '../data';

interface Props {
  foto: ImageMetadata;
  // poziția fotografiei în cadru, ca la object-position
  pozitie?: string;
  firimituri: { text: string; href?: string }[];
  titlu: string;
  accent: string;
  text: string;
  // ce află omul dacă sună: partea stângă a benzii galbene
  banda: string;
  mesaj: string;
}

const { foto, pozitie = '70% 55%', firimituri, titlu, accent, text, banda, mesaj } = Astro.props;
---

<section id="top" class="hero relative isolate overflow-hidden">
  <Image
    src={foto}
    alt=""
    widths={[768, 1280, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover"
    style={`object-position: ${pozitie}`}
  />
  <div class="hero-voal absolute inset-0 -z-10"></div>

  <div class="container-site pt-4 pb-14 lg:pt-5 lg:pb-20">
    <nav aria-label="Ești aici" class="min-w-0">
      <ol class="flex min-w-0 border-l-[3px] border-asfalt-600 py-1.5 pl-4 text-[0.85rem] text-far-300">
        {
          firimituri.map((f, i) => (
            <li class:list={['whitespace-nowrap', i === firimituri.length - 1 && 'min-w-0 truncate text-far-50']}>
              {f.href ? <a href={f.href} class="hover:text-placuta-400">{f.text}</a> : f.text}
              {i < firimituri.length - 1 && <span class="px-1.5" aria-hidden="true">/</span>}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="hero-continut mt-10 max-w-[46rem] lg:mt-16">
      <h1 class="hero-titlu text-[clamp(2.1rem,6vw,4rem)] leading-[1.05] font-extrabold tracking-tight text-white uppercase">
        {titlu} <span class="block text-placuta-400">{accent}</span>
      </h1>

      <p class="mt-5 max-w-[38rem] text-[1.125rem] leading-relaxed text-far-50 sm:text-[1.2rem]">{text}</p>

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2.5 text-far-50">
        {
          garantii.map((g) => (
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-placuta-400" aria-hidden="true">
                <path d="M4 12.5l5 5L20 6.5" />
              </svg>
              {g}
            </li>
          ))
        }
      </ul>

      <div class="banda-galbena hero-banda mt-8 flex flex-col gap-4 rounded-(--radius-banda) px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
        <div class="sm:max-w-[17rem]">
          <p class="font-medium">Suni și afli pe loc</p>
          <p class="mt-1 text-[1.6rem] leading-[1.1] font-extrabold tracking-tight">{banda}</p>
        </div>
        <div class="sm:text-right">
          <p class="font-medium">Telefon și WhatsApp</p>
          <a href={firma.telefonLink} class="mt-1 block text-[2.5rem] leading-none font-light whitespace-nowrap italic underline-offset-4 hover:underline">
            {firma.telefon}
          </a>
        </div>
      </div>

      <p class="mt-5 text-[0.95rem]">
        <a href={whatsappLink(mesaj)} target="_blank" rel="noopener" class="font-medium text-far-50 underline decoration-placuta-500 decoration-2 underline-offset-4 hover:text-placuta-400">
          Sau scrie-ne pe WhatsApp
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  /* voal: opac în stânga, sub text; fotografia rămâne vizibilă în dreapta și se topește jos în pagină */
  .hero-voal {
    background:
      linear-gradient(to top, var(--color-asfalt-950) 0%, rgb(21 22 19 / 0) 32%),
      linear-gradient(90deg, rgb(21 22 19 / 0.97) 0%, rgb(21 22 19 / 0.9) 38%, rgb(21 22 19 / 0.45) 72%, rgb(21 22 19 / 0.25) 100%);
  }

  /* laptopuri scunde: banda cu telefonul rămâne în primul ecran */
  @media (min-width: 1024px) and (max-height: 820px) {
    .hero-continut {
      margin-top: 1.75rem;
    }
    .hero-titlu {
      font-size: 3rem;
    }
    .hero-banda {
      margin-top: 1.5rem;
    }
  }

  .hero-banda {
    box-shadow: 0 22px 44px -18px rgb(0 0 0 / 0.8);
  }

  @media (max-width: 767px) {
    .hero-voal {
      background:
        linear-gradient(to top, var(--color-asfalt-950) 0%, rgb(21 22 19 / 0) 30%),
        linear-gradient(180deg, rgb(21 22 19 / 0.78) 0%, rgb(21 22 19 / 0.9) 45%, rgb(21 22 19 / 0.96) 100%);
    }
  }
</style>
