---
import { Image } from 'astro:assets';
import drum from '../assets/hero-drum.jpg';
import Stele from './Stele.astro';
import { firma, garantii, recenziiSumar, ruta, whatsappLink } from '../data';
---

<section id="top" class="hero relative isolate overflow-hidden">
  <Image
    src={drum}
    alt=""
    widths={[768, 1280, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-foto absolute inset-0 -z-20 size-full object-cover"
  />
  <div class="hero-voal absolute inset-0 -z-10"></div>

  <div class="container-site pt-4 pb-14 lg:pt-5 lg:pb-20">
    <p class="truncate border-l-[3px] border-asfalt-600 py-1.5 pl-4 text-[0.85rem] text-far-300">
      {firma.nume} / Transport persoane tur-retur Argeș – Olanda, Germania, Belgia (de la adresă la adresă) /
      <span class="text-far-50">Transport persoane Argeș–Olanda</span>
    </p>

    <div class="hero-continut mt-10 max-w-[46rem] lg:mt-16">
      <h1 class="hero-titlu text-[clamp(2.1rem,6vw,4rem)] leading-[1.05] font-extrabold tracking-tight text-white uppercase">
        Transport persoane <span class="block whitespace-nowrap text-placuta-400">Argeș–Olanda</span>
      </h1>

      <p class="mt-5 max-w-[38rem] text-[1.125rem] leading-relaxed text-far-50 sm:text-[1.2rem]">
        Te luăm de acasă, din Pitești sau din orice localitate din Argeș, și te lăsăm la adresa din Olanda. Călătorești
        cu un singur microbuz, fără schimbări și fără drumul până la autogară.
      </p>

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2.5 text-far-50">
        {
          garantii.map((text) => (
            <li class="flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-placuta-400" aria-hidden="true">
                <path d="M4 12.5l5 5L20 6.5" />
              </svg>
              {text}
            </li>
          ))
        }
      </ul>

      <div class="banda-galbena hero-banda mt-8 flex flex-col gap-4 rounded-(--radius-banda) px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
        <div>
          <p class="font-medium">Prețuri de la</p>
          <p class="mt-1 text-[2.5rem] leading-none font-extrabold tracking-tight">{ruta.pretDeLa} EURO</p>
          <p class="mt-1.5 text-[0.9rem] font-medium">de persoană, pe sens</p>
        </div>
        <div class="sm:text-right">
          <p class="font-medium">Sună acum și verifică locurile disponibile.</p>
          <a href={firma.telefonLink} class="mt-1 block text-[2.5rem] leading-none font-light italic underline-offset-4 hover:underline">
            {firma.telefon}
          </a>
          <p class="mt-1.5 text-[0.9rem] font-medium">{firma.program}</p>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3 text-[0.95rem]">
        <a href="#recenzii" class="inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 text-far-300 hover:text-far-50">
          <Stele />
          <span>
            <strong class="font-semibold text-far-50">{recenziiSumar.nota} din 5</strong> pe {recenziiSumar.sursa}, din
            {recenziiSumar.total} recenzii
          </span>
        </a>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="font-medium text-far-50 underline decoration-placuta-500 decoration-2 underline-offset-4 hover:text-placuta-400">
          Sau scrie-ne pe WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero :global(.hero-foto) {
    object-position: 70% 55%;
  }

  /* voal: opac în stânga, sub text; fotografia rămâne vizibilă în dreapta și se topește jos în pagină */
  .hero-voal {
    background:
      linear-gradient(to top, var(--color-asfalt-950) 0%, rgb(21 22 19 / 0) 32%),
      linear-gradient(90deg, rgb(21 22 19 / 0.97) 0%, rgb(21 22 19 / 0.9) 38%, rgb(21 22 19 / 0.45) 72%, rgb(21 22 19 / 0.25) 100%);
  }

  /* laptopuri scunde: prețul și telefonul rămân în primul ecran */
  @media (min-width: 1024px) and (max-height: 820px) {
    .hero-continut {
      margin-top: 1.75rem;
    }
    .hero-titlu {
      font-size: 3rem;
    }
    .hero-banda {
      margin-top: 1.5rem;
    }
  }

  .hero-banda {
    box-shadow: 0 22px 44px -18px rgb(0 0 0 / 0.8);
  }

  @media (max-width: 767px) {
    .hero-voal {
      background:
        linear-gradient(to top, var(--color-asfalt-950) 0%, rgb(21 22 19 / 0) 30%),
        linear-gradient(180deg, rgb(21 22 19 / 0.78) 0%, rgb(21 22 19 / 0.9) 45%, rgb(21 22 19 / 0.96) 100%);
    }
  }
</style>
