---
import { firma, reguliColete } from '../data';
---

<section id="colet" class="container-site apare">
  <h2 class="titlu-sectiune">Ce poți trimite și cum pregătești coletul</h2>
  <hr class="linie" />
  <p>Dacă nu ești sigur că putem lua un anumit lucru, întreabă-ne înainte să îl împachetezi.</p>

  <dl class="mt-6 grid gap-6 md:grid-cols-3">
    {
      reguliColete.map((grup) => (
        <div class="ridicat rounded-(--radius-card) p-5">
          <dt class="text-[0.95rem] font-semibold text-far-50 uppercase">{grup.titlu}</dt>
          <dd class="mt-3">
            <ul class="lista-cercuri">
              {grup.lista.map((rand) => (
                <li>{rand}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-8 banda-galbena rounded-(--radius-banda) px-6 py-8 text-center">
    <p class="text-[clamp(1.6rem,4vw,2rem)] leading-tight">Ai un colet mai mare sau mai greu?</p>
    <p class="mt-3 font-medium">Sună-ne și îți spunem dacă îl putem lua și cât costă</p>
    <a href={firma.telefonLink} class="mt-1 block text-[clamp(2.4rem,7vw,3rem)] leading-tight font-extrabold tracking-tight italic underline-offset-[6px] hover:underline">
      {firma.telefon}
    </a>
  </div>
</section>
