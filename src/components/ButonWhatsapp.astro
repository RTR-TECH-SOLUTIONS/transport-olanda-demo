<style>
  .whatsapp {
    background: #1fa855;
    box-shadow: 0 8px 22px -6px rgb(0 0 0 / 0.7);
    transition:
      background-color 180ms var(--ease-out-soft),
      transform 180ms var(--ease-out-soft);
  }

  .whatsapp:hover {
    background: #25c063;
    transform: translateY(-2px);
  }
</style>
