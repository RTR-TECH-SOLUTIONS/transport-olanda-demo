---
// Banda neagră: text mic în stânga, telefonul mare în dreapta.
import { firma } from '../data';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="container-site">
  <div class="flex flex-col gap-3 rounded-(--radius-banda) bg-noapte px-8 py-7 text-far-500 md:flex-row md:items-center md:justify-around md:py-10">
    <p class="md:max-w-[15rem]">{text}</p>
    <a href={firma.telefonLink} class="text-[clamp(2.25rem,5vw,3rem)] leading-tight font-light text-far-300 italic transition-colors duration-200 hover:text-placuta-400 underline-offset-[6px] hover:underline">
      Sună la {firma.telefon}
    </a>
  </div>
</div>
