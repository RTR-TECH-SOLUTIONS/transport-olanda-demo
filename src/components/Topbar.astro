---
// Banda subțire de deasupra antetului.
import { listaTari, whatsappLink } from '../data';
---

<div class="bg-noapte text-[0.875rem] text-far-300">
  <div class="container-site flex min-h-9 flex-wrap items-center justify-between gap-x-6 py-1.5">
    <p>
      Transport persoane și colete<span class="hidden sm:inline">: România – {listaTari}</span>
    </p>
    <p class="hidden md:block">
      <a href={whatsappLink()} target="_blank" rel="noopener" class="hover:text-placuta-400">Scrie-ne pe WhatsApp</a>
    </p>
  </div>
</div>
