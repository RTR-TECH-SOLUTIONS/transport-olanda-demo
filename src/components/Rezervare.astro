---
import { firma, oraseArges, oraseOlanda, pasi } from '../data';
---

<section id="rezervare" class="container-site apare">
  <h2 class="titlu-sectiune">Cum rezervi un loc</h2>

  <ol class="mt-10 grid gap-8 px-0 md:grid-cols-3 md:px-4">
    {
      pasi.map((pas) => (
        <li class="ridicat rounded-(--radius-card) p-4 pb-6">
          <h3 class="mt-3 text-[1.3rem] font-normal">{pas.titlu}</h3>
          <p class="mt-5">{pas.text}</p>
          {pas.lista && (
            <ul class="lista-buline mt-2">
              {pas.lista.map((rand) => (
                <li>{rand}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>

  <form class="ridicat mt-8 flex flex-col gap-7 rounded-(--radius-card) p-5 md:mx-4 lg:flex-row lg:gap-12 lg:p-8" data-cerere data-whatsapp={firma.whatsapp} novalidate>
    <div class="lg:max-w-[17rem]">
      <h3 class="text-[1.3rem] font-normal">Sau cere un loc pe WhatsApp</h3>
      <p class="mt-3">
        Completezi cele patru câmpuri, iar mesajul se deschide gata scris în WhatsApp. Îți răspundem în aceeași zi.
      </p>
    </div>

    <div class="grid flex-1 gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1.5 block text-sm text-far-50">Localitatea de plecare</span>
        <input class="camp" name="plecare" list="lista-plecare" placeholder="ex. Mioveni" autocomplete="address-level2" required />
        <datalist id="lista-plecare">
          {oraseArges.map((oras) => <option value={oras} />)}
        </datalist>
      </label>

      <label class="block">
        <span class="mb-1.5 block text-sm text-far-50">Destinația din Olanda</span>
        <input class="camp" name="destinatie" list="lista-destinatie" placeholder="ex. Eindhoven" required />
        <datalist id="lista-destinatie">
          {oraseOlanda.map((oras) => <option value={oras} />)}
        </datalist>
      </label>

      <label class="block">
        <span class="mb-1.5 block text-sm text-far-50">Data plecării</span>
        <input class="camp" type="date" name="data" required />
      </label>

      <label class="block">
        <span class="mb-1.5 block text-sm text-far-50">Câte persoane</span>
        <select class="camp" name="persoane">
          {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={n}>{n}</option>)}
        </select>
      </label>

      <div class="sm:col-span-2">
        <p class="mb-3 hidden text-[0.95rem] font-medium text-placuta-400" role="alert" data-cerere-eroare>
          Completează localitatea de plecare, destinația și data.
        </p>
        <button type="submit" class="btn btn-galben w-full sm:w-auto">Trimite cererea pe WhatsApp</button>
      </div>
    </div>
  </form>
</section>

<script>
  // TODO(real): pe proiectul real, cererea se poate salva și într-un CMS / trimite pe e-mail (Resend).
  const form = document.querySelector<HTMLFormElement>('[data-cerere]');
  const eroare = document.querySelector<HTMLElement>('[data-cerere-eroare]');

  if (form) {
    const data = form.elements.namedItem('data') as HTMLInputElement;
    data.min = new Date().toISOString().slice(0, 10);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const valori = new FormData(form);
      const plecare = String(valori.get('plecare') ?? '').trim();
      const destinatie = String(valori.get('destinatie') ?? '').trim();
      const zi = String(valori.get('data') ?? '');
      const persoane = String(valori.get('persoane') ?? '1');

      const lipsa = !plecare || !destinatie || !zi;
      eroare?.classList.toggle('hidden', !lipsa);
      if (lipsa) {
        form.querySelector<HTMLElement>('input:invalid')?.focus();
        return;
      }

      const dataRo = new Date(`${zi}T12:00:00`).toLocaleDateString('ro-RO', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      });
      const mesaj = [
        'Bună ziua, aș vrea un loc pe ruta Argeș – Olanda.',
        `Plecare din: ${plecare}`,
        `Destinație: ${destinatie}`,
        `Data: ${dataRo}`,
        `Persoane: ${persoane}`,
      ].join('\n');

      window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(mesaj)}`, '_blank', 'noopener');
    });
  }
</script>
