---
import { acte, firma } from '../data';

interface Props {
  tara: string;
}

const { tara } = Astro.props;
---

<section id="acte" class="container-site apare">
  <h2 class="titlu-sectiune">Acte necesare pentru călătorie</h2>
  <hr class="linie" />
  <p>
    Pentru {tara} ajunge un document de identitate valabil. Dacă pleci cu un minor, mai sunt necesare câteva documente,
    în funcție de cine îl însoțește.
  </p>

  <div class="mt-3 grid gap-6 md:grid-cols-[1fr_2fr]">
    <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-placuta-500" aria-hidden="true">
      <path d="M12 2.5H8.5C5.5 2.5 3.5 4.5 3.5 7.5v9c0 3 2 5 5 5h5c3 0 5-2 5-5V14" />
      <path d="M3.5 13.5c2.5 0 4 1.5 4.5 3.5.3 1.4 1.2 2.4 2.500 2.800" />
      <circle cx="17.500" cy="6.500" r="4" />
      <path d="M15.800 6.600l1.200 1.200 2.200-2.400" />
    </svg>

    <dl>
      {
        acte.map((grup) => (
          <div class="border-b border-asfalt-700 pt-3 pb-1 last:border-0">
            <dt class="text-[0.95rem] font-semibold text-far-50 uppercase">{grup.titlu}</dt>
            <dd class="mt-3">
              <ul class="lista-cercuri">
                {grup.lista.map((rand) => (
                  <li>{rand}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="mt-4 banda-galbena rounded-(--radius-banda) px-6 py-8 text-center">
    <p class="text-[clamp(1.6rem,4vw,2rem)] leading-tight">Nu ești sigur ce documente îți trebuie?</p>
    <p class="mt-3 font-medium">Sună-ne și te lămurim înainte de plecare</p>
    <a href={firma.telefonLink} class="mt-1 block text-[clamp(2.4rem,7vw,3rem)] leading-tight font-extrabold tracking-tight italic underline-offset-[6px] hover:underline">
      {firma.telefon}
    </a>
  </div>
</section>
